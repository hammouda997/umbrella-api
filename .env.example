DATABASE_URL="postgresql://umbrella:umbrella@localhost:5436/umbrella?schema=public"
JWT_SECRET=change-me-access-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-min-32-chars-long
PORT=3011
NODE_ENV=development
CORS_ORIGIN="http://localhost:3010"
SWAGGER_ENABLED=false

# Navex EXTERNAL delivery (leave disabled until credentials verified)
NAVEX_ENABLED=false
NAVEX_API_BASE_URL="https://app.navex.tn/api"
NAVEX_CLIENT_SLUG=
NAVEX_API_KEY=
NAVEX_API_TOKEN=

# WebRTC TURN (Coturn). Required for reliable audio calls in production.
TURN_SECRET=
TURN_REALM=umbrella.local
TURN_URLS=

# Optional observability / inbound contact
SENTRY_DSN=
CONTACT_INBOX=contact@umbrella.tn

# One-off prod admin (never commit real values):
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_ADMIN_PHONE=
