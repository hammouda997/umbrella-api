generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EXPERT_COMPTABLE
  CHEF_AGENCE
  SUPPORT
  PICKUP
  MAGASINIER
  FINANCE
  EXPEDITEUR
  LIVREUR
  CLIENT
}

/** Caisse dépense (agency) vs caisse COD (globale livreurs). */
enum CashRegisterKind {
  DEPENSE
  COD
}

enum CashMovementType {
  IN
  OUT
}

enum DeliveryMode {
  EXTERNAL
  INTERNAL
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ParcelStatus {
  NON_SERIEUX
  EN_ATTENTE
  A_ENLEVER
  ENLEVES
  AU_DEPOT
  EXPEDIE_DESTINATION
  ARRIVE_DESTINATION
  AFFECTE_LIVREUR
  RETOUR_DEPOT
  EN_COURS
  A_VERIFIER
  LIVRES
  LIVRES_PAYES
  ECHANGES
  REMBOURSES
  LIVRAISON_ANNULEE
  RETOUR_DEFINITIF
  RETOUR_INTER_AGENCE
  RETOUR_EXPEDITEURS
  RETOUR_RECU
  SAISIE_DOUANE
  SUPPRIME
}

model User {
  id               Int              @id @default(autoincrement())
  name             String
  email            String           @unique
  password         String
  phone            String?
  role             Role             @default(CLIENT)
  agencyId         Int?
  agency           Agency?          @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  zoneId           Int?
  homeZone         Zone?            @relation("LivreurZone", fields: [zoneId], references: [id], onDelete: SetNull)
  approvalStatus   ApprovalStatus   @default(APPROVED)
  approvedAt       DateTime?
  approvedById     Int?
  approvedBy       User?            @relation("UserApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedUsers    User[]           @relation("UserApprover")
  governorate      String?
  city             String?
  address          String?
  shopName         String?
  productTypes     String[]         @default([])
  productNotes     String?
  refreshToken     String?
  passwordResetToken   String?
  passwordResetExpires DateTime?
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  parcels          Parcel[]         @relation("SenderParcels")
  assigned         Parcel[]         @relation("DriverParcels")
  zones            Zone[]
  ticketsCreated   Ticket[]         @relation("TicketCreator")
  paymentRequests  PaymentRequest[]
  parcelEvents     ParcelEvent[]
  codSettlements   Parcel[]         @relation("CodSettler")
  conversationParts ConversationParticipant[]
  messagesSent     Message[]        @relation("MessageSender")
  callsMade        CallSession[]    @relation("CallCaller")
  callsReceived    CallSession[]    @relation("CallCallee")
  returnLots       ReturnLot[]
  pickupManifestsCreated PickupManifest[] @relation("PickupManifestCreator")
  pickupManifestsAsSender PickupManifest[] @relation("PickupManifestSender")
  cashMovements    CashMovement[]
  livreurDeposits  LivreurDeposit[] @relation("LivreurDeposits")
  depositsReviewed LivreurDeposit[] @relation("DepositReviewer")

  @@index([agencyId])
  @@index([zoneId])
  @@index([approvalStatus])
}

/** Gouvernorat agency — separate from livreur fleet Zone. */
model Agency {
  id                    Int       @id @default(autoincrement())
  name                  String
  governorate           String    @unique
  isActive              Boolean   @default(true)
  expertBatchDeadlineAt DateTime?
  users                 User[]
  parcels               Parcel[]
  cashRegisters         CashRegister[]
  livreurDeposits       LivreurDeposit[]
  returnLots            ReturnLot[]
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

enum LivreurDepositStatus {
  PENDING
  ACCEPTED
  REJECTED
}

/** Versement COD livreur avec photo du reçu — accepté seulement si solde float = 0. */
model LivreurDeposit {
  id                 Int                  @id @default(autoincrement())
  livreurId          Int
  livreur            User                 @relation("LivreurDeposits", fields: [livreurId], references: [id], onDelete: Cascade)
  agencyId           Int?
  agency             Agency?              @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  amount             Decimal              @db.Decimal(14, 3)
  expectedAmount     Decimal              @db.Decimal(14, 3)
  receiptUrl         String
  status             LivreurDepositStatus @default(PENDING)
  runsheetParcelIds  Int[]                @default([])
  rejectReason       String?
  reviewedById       Int?
  reviewedBy         User?                @relation("DepositReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt         DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  movements          CashMovement[]

  @@index([livreurId, status])
  @@index([agencyId, status])
  @@index([status, createdAt])
}

/**
 * Two cash boxes:
 * - DEPENSE: agency operating expenses (agencyId required)
 * - COD: global livreur COD intake (agencyId null = réseau)
 */
model CashRegister {
  id        Int              @id @default(autoincrement())
  kind      CashRegisterKind
  name      String
  agencyId  Int?
  agency    Agency?          @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  balance   Decimal          @default(0) @db.Decimal(14, 3)
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  movements CashMovement[]

  @@unique([kind, agencyId])
  @@index([kind])
  @@index([agencyId])
}

model CashMovement {
  id          Int              @id @default(autoincrement())
  registerId  Int
  register    CashRegister     @relation(fields: [registerId], references: [id], onDelete: Cascade)
  type        CashMovementType
  amount      Decimal          @db.Decimal(14, 3)
  label       String
  note        String?
  receiptUrl  String?
  invoiceRef  String?
  depositId   Int?
  deposit     LivreurDeposit?  @relation(fields: [depositId], references: [id], onDelete: SetNull)
  actorId     Int?
  actor       User?            @relation(fields: [actorId], references: [id], onDelete: SetNull)
  parcelId    Int?
  livreurId   Int?
  createdAt   DateTime         @default(now())

  @@index([registerId, createdAt])
  @@index([actorId])
  @@index([livreurId])
  @@index([depositId])
}

/**
 * Super-admin routing: which gouvernorat defaults to Navex (EXTERNAL)
 * vs Umbrella fleet (INTERNAL) when creating a parcel.
 */
model DeliveryRoute {
  id          Int          @id @default(autoincrement())
  governorate String       @unique
  mode        DeliveryMode @default(EXTERNAL)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

/** Livreur / fleet delivery zone (map radius). Not used for agency staff scope. */
model Zone {
  id          Int      @id @default(autoincrement())
  name        String
  governorate String?
  centerLat   Float?
  centerLng   Float?
  radiusKm    Float?
  isActive    Boolean  @default(true)
  createdById Int?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  drivers     User[]   @relation("LivreurZone")
  parcels     Parcel[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Parcel {
  id            Int           @id @default(autoincrement())
  code          String?       @unique
  recipientName String
  phone         String
  phone2        String?
  governorate   String
  city          String
  locality      String?
  address       String
  price         Decimal       @db.Decimal(12, 3)
  articleCount  Int           @default(1)
  parcelCount   Int           @default(1)
  designation   String?
  notes         String?
  paymentMode   String?
  allowOpen     Boolean       @default(false)
  isFragile     Boolean       @default(false)
  isExchange    Boolean       @default(false)
  exchangeNotes String?
  mode          DeliveryMode  @default(EXTERNAL)
  status        ParcelStatus  @default(EN_ATTENTE)
  bordereauUrl  String?
  navexRaw      Json?
  lastLat       Float?
  lastLng       Float?
  lat           Float?
  lng           Float?
  deliveryWindow      String?
  tryProduct          Boolean   @default(false)
  liabilityAcceptedAt DateTime?
  landmarkPhotoName   String?
  addressQuality      Int?
  codSettledAt        DateTime?
  codSettledById      Int?
  codSettledBy        User?     @relation("CodSettler", fields: [codSettledById], references: [id], onDelete: SetNull)
  events              ParcelEvent[]
  senderId      Int
  sender        User          @relation("SenderParcels", fields: [senderId], references: [id])
  driverId      Int?
  driver        User?         @relation("DriverParcels", fields: [driverId], references: [id])
  zoneId        Int?
  zone          Zone?         @relation(fields: [zoneId], references: [id])
  agencyId      Int?
  agency        Agency?       @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  tickets       Ticket[]
  paymentItems  PaymentItem[]
  conversations Conversation[]
  returnLotItems ReturnLotItem[]
  pickupManifestItems PickupManifestItem[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
  @@index([senderId])
  @@index([mode])
  @@index([driverId])
  @@index([code])
  @@index([agencyId])
}

enum ReturnLotStatus {
  OPEN
  CLOSED
}

model ReturnLot {
  id                   Int             @id @default(autoincrement())
  code                 String          @unique
  senderId             Int
  sender               User            @relation(fields: [senderId], references: [id], onDelete: Cascade)
  destinationLabel     String?
  destinationAgencyId  Int?
  destinationAgency    Agency?         @relation(fields: [destinationAgencyId], references: [id], onDelete: SetNull)
  status               ReturnLotStatus @default(OPEN)
  closedAt             DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  items                ReturnLotItem[]

  @@index([senderId])
  @@index([status])
  @@index([code])
  @@index([destinationAgencyId])
}

model ReturnLotItem {
  id        Int       @id @default(autoincrement())
  lotId     Int
  lot       ReturnLot @relation(fields: [lotId], references: [id], onDelete: Cascade)
  parcelId  Int       @unique
  parcel    Parcel    @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([lotId])
}

enum PickupManifestKind {
  EN_ATTENTE
  PRE_ENLEVEMENT
}

enum PickupManifestStatus {
  OPEN
  CLOSED
}

model PickupManifest {
  id          Int                  @id @default(autoincrement())
  code        String               @unique
  kind        PickupManifestKind
  status      PickupManifestStatus @default(OPEN)
  createdById Int
  createdBy   User                 @relation("PickupManifestCreator", fields: [createdById], references: [id], onDelete: Cascade)
  senderId    Int?
  sender      User?                @relation("PickupManifestSender", fields: [senderId], references: [id], onDelete: SetNull)
  dechargeUrl String?
  cinUrl      String?
  closedAt    DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  items       PickupManifestItem[]

  @@index([kind])
  @@index([status])
  @@index([createdById])
  @@index([senderId])
  @@index([code])
}

model PickupManifestItem {
  id         Int            @id @default(autoincrement())
  manifestId Int
  manifest   PickupManifest @relation(fields: [manifestId], references: [id], onDelete: Cascade)
  parcelId   Int            @unique
  parcel     Parcel         @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  sortOrder  Int            @default(0)
  createdAt  DateTime       @default(now())

  @@index([manifestId])
}

model ParcelEvent {
  id        Int           @id @default(autoincrement())
  parcelId  Int
  parcel    Parcel        @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  status    ParcelStatus?
  label     String
  comment   String?
  actorId   Int?
  actor     User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())

  @@index([parcelId, createdAt])
}

enum TicketStatus {
  EN_COURS
  RESOLU
  FERME
}

enum TicketKind {
  GENERAL
  CHANGEMENT_PRIX
  RELANCE
}

model Ticket {
  id             Int          @id @default(autoincrement())
  title          String
  description    String?
  kind           TicketKind   @default(GENERAL)
  requestedPrice Decimal?     @db.Decimal(12, 3)
  status         TicketStatus @default(EN_COURS)
  parcelId       Int?
  parcel         Parcel?      @relation(fields: [parcelId], references: [id])
  createdById    Int
  createdBy      User         @relation("TicketCreator", fields: [createdById], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([createdById])
  @@index([status])
  @@index([kind])
  @@index([parcelId])
}

enum PaymentRequestStatus {
  EN_DEMANDE
  VALIDE_FINANCE
  VALIDE_CHEF
  VALIDE_EXPERT
  APPROUVE
  PAYE
  REJETE
}

model PaymentRequest {
  id            Int                  @id @default(autoincrement())
  amount        Decimal              @db.Decimal(12, 3)
  status        PaymentRequestStatus @default(EN_DEMANDE)
  note          String?
  /** [{ at, status, label, actorName? }] */
  statusHistory Json?
  senderId      Int
  sender        User                 @relation(fields: [senderId], references: [id])
  items         PaymentItem[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([senderId])
  @@index([status])
}

model PaymentItem {
  id               Int            @id @default(autoincrement())
  paymentRequestId Int
  paymentRequest   PaymentRequest @relation(fields: [paymentRequestId], references: [id], onDelete: Cascade)
  parcelId         Int
  parcel           Parcel         @relation(fields: [parcelId], references: [id])
  amount           Decimal        @db.Decimal(12, 3)

  @@unique([paymentRequestId, parcelId])
}

/** Dashboard KPI category styling (color + icon). Managed by SUPER_ADMIN only. */
model StatusCategory {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  label     String
  color     String
  icon      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

enum CallStatus {
  RINGING
  ACTIVE
  ENDED
  MISSED
  REJECTED
}

model Conversation {
  id            Int                       @id @default(autoincrement())
  parcelId      Int?
  parcel        Parcel?                   @relation(fields: [parcelId], references: [id], onDelete: SetNull)
  lastMessageAt DateTime?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  participants  ConversationParticipant[]
  messages      Message[]
  calls         CallSession[]

  @@index([lastMessageAt])
  @@index([parcelId])
}

model ConversationParticipant {
  id             Int          @id @default(autoincrement())
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         Int
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt     DateTime?
  createdAt      DateTime     @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             Int          @id @default(autoincrement())
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       Int
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  body           String
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model CallSession {
  id             Int          @id @default(autoincrement())
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  callerId       Int
  caller         User         @relation("CallCaller", fields: [callerId], references: [id], onDelete: Cascade)
  calleeId       Int
  callee         User         @relation("CallCallee", fields: [calleeId], references: [id], onDelete: Cascade)
  status         CallStatus   @default(RINGING)
  startedAt      DateTime?
  endedAt        DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([conversationId])
  @@index([callerId])
  @@index([calleeId])
  @@index([status])
}
